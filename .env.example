# ==============================================================================
# JABVOX MAIL & CALENDAR — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANTE: Copia este archivo a `.env` y completa tus credenciales.
# NUNCA compartas ni subas tu archivo `.env` real a repositorios públicos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://jabvox:jabvox_secret@localhost:5433/jabvox_mail?schema=public"
POSTGRES_DB="jabvox_mail"
POSTGRES_USER="jabvox"
POSTGRES_PASSWORD="jabvox_secret"
DB_PORT="5433"

# ------------------------------------------------------------------------------
# 2. APLICACIÓN Y SEGURIDAD
# ------------------------------------------------------------------------------
PORT="3005"
NEXTAUTH_URL="http://localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Clave secreta para firma de sesiones y tokens (32 bytes = 64 caracteres hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-a-64-character-hex-string"

# Clave criptográfica para cifrado simétrico de Tokens OAuth en reposo (AES-256-GCM)
# Debe ser una cadena hexadecimal válida de 64 caracteres (256 bits).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-64-character-hex-string"

# ------------------------------------------------------------------------------
# 3. PROVEEDOR GOOGLE CLOUD (Gmail API v1, Calendar API v3, Google Meet)
# ------------------------------------------------------------------------------
# Obtenidos en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3005/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 4. PROVEEDOR MICROSOFT ENTRA ID (Microsoft Graph API - Outlook / 365)
# ------------------------------------------------------------------------------
# Obtenidos en: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID="your-microsoft-app-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-app-client-secret"
MICROSOFT_REDIRECT_URI="http://localhost:3005/api/auth/microsoft/callback"

# ------------------------------------------------------------------------------
# 5. SERVIDOR SMTP (Opcional - Restablecimiento de contraseña)
# ------------------------------------------------------------------------------
# Si se deja vacío en desarrollo, los enlaces de recuperación se imprimirán en consola.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="soporte@jabvox.com"
