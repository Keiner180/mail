# Database
DATABASE_URL="postgresql://jabvox:jabvox_secret@localhost:5433/jabvox_mail?schema=public"
POSTGRES_DB="jabvox_mail"
POSTGRES_USER="jabvox"
POSTGRES_PASSWORD="jabvox_secret"
DB_PORT="5433"

# App
PORT="3005"
NEXTAUTH_URL="http://localhost:3005"
APP_SECRET="replace-with-a-32-byte-hex-string"
# 32-byte (64 hex characters) encryption key for AES-256-GCM token encryption
ENCRYPTION_KEY="replace-with-a-64-character-hex-string"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3005/api/auth/google/callback"

# Optional SMTP for Password Reset Emails (leave blank to log reset links to console)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@jabvox.com"

